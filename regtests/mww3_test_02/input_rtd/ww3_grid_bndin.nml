! -------------------------------------------------------------------- !
! WAVEWATCH III - ww3_grid.nml - Grid pre-processing                   !
! -------------------------------------------------------------------- !

! -------------------------------------------------------------------- !
! Define the spectrum parameterization via SPECTRUM_NML namelist
! -------------------------------------------------------------------- !
&SPECTRUM_NML
  SPECTRUM%XFR       =  1.1
  SPECTRUM%FREQ1     =  0.067
  SPECTRUM%NK        =  13
  SPECTRUM%NTH       =  24
/

! -------------------------------------------------------------------- !
! Define the run parameterization via RUN_NML namelist
! -------------------------------------------------------------------- !
&RUN_NML
  RUN%FLCX         =  T
  RUN%FLCY         =  T
/

! -------------------------------------------------------------------- !
! Define the timesteps parameterization via TIMESTEPS_NML namelist
! -------------------------------------------------------------------- !
&TIMESTEPS_NML
  TIMESTEPS%DTMAX        =  3600
  TIMESTEPS%DTXY         =  1800
  TIMESTEPS%DTKTH        =  1800
  TIMESTEPS%DTMIN        =  60
/

! -------------------------------------------------------------------- !
! Define the grid to preprocess via GRID_NML namelist
! -------------------------------------------------------------------- !
&GRID_NML
  GRID%NAME         =  'RTD grid input BC'
  GRID%NML          =  '../input_rtd/namelists_rtd.nml'
  GRID%TYPE         =  'RECT'
  GRID%COORD        =  'SPHE'
  GRID%CLOS         =  'NONE'
  GRID%ZLIM         =  -0.1
  GRID%DMIN         =  10.0
/

! -------------------------------------------------------------------- !
! Define the rectilinear grid type via RECT_NML namelist
! -------------------------------------------------------------------- !
&RECT_NML
  RECT%NX           =  15
  RECT%NY           =  15
  RECT%SX           =  0.9
  RECT%SY           =  0.9
  RECT%SF           =  1.0
  RECT%X0           =  -7.19 ! x0 >~ -5.625-1.8 = -7.425 x1 <~ 5.625 x1=x0+(NX-1)*0.9
  RECT%Y0           =  -7.19 ! NX=15: x0 = -7.19:  x1 = 5.41
!  RECT%X0           =  -7.3125 ! x0 < -5.625+1.5*0.225-1.8 = -6.1875 x0 = x1-(NX-1)*0.9
!  RECT%Y0           =  -7.3125 ! NX=15: x0 = -7.3125  x1 = 3.825-1.5*0.225+1.8 = 5.2875
/

! -------------------------------------------------------------------- !
! Define the depth to preprocess via DEPTH_NML namelist
! -------------------------------------------------------------------- !
&DEPTH_NML
  DEPTH%SF        =  -1000.
  DEPTH%FILENAME  =  '../input_rtd/bndin.depth'
  DEPTH%IDLA      =  4
/

! -------------------------------------------------------------------- !
! Define the point status map via MASK_NML namelist
! -------------------------------------------------------------------- !
&MASK_NML
  MASK%FILENAME  =  '../input_rtd/bndin.mask'
  MASK%IDLA      =  4
/

! -------------------------------------------------------------------- !
! WAVEWATCH III - end of namelist                                      !
! -------------------------------------------------------------------- !
